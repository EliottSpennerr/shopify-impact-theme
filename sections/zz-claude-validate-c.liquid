{%- if section.blocks.size > 0 -%}
  {%- liquid
    # Judge.me sparar värdena som äldre textmetafält: nås direkt eller via .value beroende på typ
    assign jm_rating_raw = shop.metafields.judgeme.all_reviews_rating.value | default: shop.metafields.judgeme.all_reviews_rating
    assign jm_count_raw = shop.metafields.judgeme.all_reviews_count.value | default: shop.metafields.judgeme.all_reviews_count
    assign jm_rating = jm_rating_raw | default: 0 | plus: 0 | round: 1
    assign jm_count = jm_count_raw | default: 0 | plus: 0
    if jm_count >= 1000
      assign jm_thousands = jm_count | divided_by: 1000
      assign jm_rest = jm_count | modulo: 1000 | prepend: '00' | slice: -3, 3
      assign jm_count_text = jm_thousands | append: ' ' | append: jm_rest
    else
      assign jm_count_text = jm_count | append: ''
    endif
  -%}
  <div {% render 'surface', class: 'announcement-bar', background_gradient: section.settings.background_gradient, background: section.settings.background, text_color: section.settings.text_color %}>
  {%- for block in section.blocks -%}
    {%- if jm_count == 0 and block.settings.text contains '[recensioner]' -%}{%- continue -%}{%- endif -%}
    <p class="bold {{ section.settings.text_size }} {% unless forloop.first %}reveal-invisible{% endunless %}" {{ block.shopify_attributes }}>
      {%- if block.settings.url != blank -%}
        <a href="{{ block.settings.url }}">{{ block.settings.text | replace: '[betyg]', jm_rating | replace: '[recensioner]', jm_count_text | escape }}</a>
      {%- else -%}
        {{ block.settings.text | replace: '[betyg]', jm_rating | replace: '[recensioner]', jm_count_text | escape }}
      {%- endif -%}
    </p>
  {%- endfor -%}
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "aside",
  "max_blocks": 5,
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Announce something here", "info": "[betyg] and [recensioner] are replaced with the current Judge.me rating and review count." },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "settings": [
    { "type": "checkbox", "id": "enable_sticky", "label": "Enable sticky bar", "default": false },
    { "type": "select", "id": "text_size", "label": "Text size", "options": [{ "value": "text-xs", "label": "Small" }, { "value": "text-base", "label": "Medium" }], "default": "text-xs" },
    { "type": "color", "id": "background", "label": "Background" },
    { "type": "color_background", "id": "background_gradient", "label": "Background gradient" },
    { "type": "color", "id": "text_color", "label": "Text" }
  ]
}
{% endschema %}

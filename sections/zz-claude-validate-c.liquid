{%- comment -%}
----------------------------------------------------------------------------------------------------------------------
KOLLEKTIONSHUVUD (som apohem.se)
----------------------------------------------------------------------------------------------------------------------

Brödsmulor, kollektionens eget namn som rubrik, beskrivningen och "Letar du efter något speciellt?" med knappar
till andra kategorier (block). Knappen till kollektionen man står på döljs. Stil i assets/collection-page.css.
{%- endcomment -%}

{%- render 'section-spacing-collapsing' -%}
{{- 'collection-page.css' | asset_url | stylesheet_tag -}}

{%- liquid
  assign header_title = collection.title
  if header_title == blank
    assign header_title = page_title
  endif

  assign parent = section.settings.breadcrumb_parent
  assign show_parent = false
  if parent != blank and parent.handle != collection.handle
    assign show_parent = true
  endif
-%}

<div {% render 'section-properties' %}>
  <div class="collection-header">
    {%- if section.settings.show_breadcrumb -%}
      <nav class="collection-header__breadcrumb" aria-label="{{ 'custom.breadcrumb.label' | t | escape }}">
        <ol role="list">
          <li><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a></li>

          {%- if show_parent -%}
            <li><a href="{{ parent.url }}">{{ parent.title }}</a></li>
          {%- endif -%}

          <li><span aria-current="page">{{ header_title }}</span></li>
        </ol>
      </nav>
    {%- endif -%}

    <h1 class="collection-header__title">{{ header_title }}</h1>

    {%- if section.settings.show_description and collection.description != blank -%}
      <div class="collection-header__description prose">{{ collection.description }}</div>
    {%- endif -%}

    {%- capture links -%}
      {%- for block in section.blocks -%}
        {%- liquid
          assign link_collection = block.settings.collection
          assign link_url = block.settings.link | default: link_collection.url
          assign link_label = block.settings.label | default: link_collection.title

          assign is_current = false
          if section.settings.hide_current and link_collection != blank and link_collection.handle == collection.handle
            assign is_current = true
          endif
          if section.settings.hide_current and block.settings.link != blank and block.settings.link == collection.url
            assign is_current = true
          endif
        -%}

        {%- if link_url != blank and link_label != blank and is_current == false -%}
          <li {{ block.shopify_attributes }}><a href="{{ link_url }}" class="collection-header__link">{{ link_label | escape }}</a></li>
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}

    {%- if links != blank -%}
      <div class="collection-header__links">
        {%- if section.settings.links_title != blank -%}
          <p class="collection-header__links-title">{{ section.settings.links_title | escape }}</p>
        {%- endif -%}

        {%- comment -%}Mobil: en rad att dra i sidled med kanttoning (assets/custom-sections.js), dator: centrerade knappar{%- endcomment -%}
        <div class="collection-header__links-row" data-edge-fade>
          <ul class="collection-header__links-list" role="list" data-edge-fade-scroller>
            {{- links -}}
          </ul>
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Kollektionshuvud",
  "class": "shopify-section--collection-header",
  "tag": "section",
  "enabled_on": {
    "templates": ["collection"]
  },
  "max_blocks": 12,
  "settings": [
    { "type": "checkbox", "id": "show_breadcrumb", "label": "Visa brödsmulor", "default": true },
    {
      "type": "collection",
      "id": "breadcrumb_parent",
      "label": "Brödsmulor: överordnad kollektion",
      "info": "Visas mellan Hem och kollektionen, t.ex. Alla produkter."
    },
    { "type": "checkbox", "id": "show_description", "label": "Visa beskrivning", "default": true },
    { "type": "text", "id": "links_title", "label": "Rubrik över knapparna", "default": "Letar du efter något speciellt?" },
    { "type": "checkbox", "id": "hide_current", "label": "Dölj knappen till kollektionen man står på", "default": true },
    { "type": "color", "id": "background", "label": "Bakgrund" },
    { "type": "color", "id": "text_color", "label": "Text" }
  ],
  "blocks": [
    {
      "type": "link",
      "name": "Knapp",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Kollektion" },
        { "type": "text", "id": "label", "label": "Text", "info": "Tomt: kollektionens namn" },
        { "type": "url", "id": "link", "label": "Egen länk", "info": "Används i stället för kollektionen" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Kollektionshuvud"
    }
  ]
}
{% endschema %}

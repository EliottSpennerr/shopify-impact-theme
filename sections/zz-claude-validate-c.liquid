{%- assign instagram_url = section.settings.instagram_url | default: settings.social_instagram -%}
{%- if section.blocks.size > 0 or request.design_mode -%}
  <div class="sweet-social {% if section.settings.show_all_mobile %}sweet-social--all-mobile{% endif %}">
    {%- for slot in (1..11) -%}
      {%- liquid
        assign block_count = section.blocks.size
        assign tile_block = nil
        if slot <= block_count
          assign index = slot | minus: 1
          assign tile_block = section.blocks[index]
        elsif block_count > 0 and request.design_mode == false
          assign index = slot | minus: 1 | modulo: block_count
          assign tile_block = section.blocks[index]
        endif
      -%}
      {%- if tile_block == blank -%}
        {{- 'lifestyle-1' | placeholder_svg_tag: 'sweet-social__placeholder' -}}
      {%- else -%}
        {%- liquid
          assign media_video = tile_block.settings.video
          assign media_image = tile_block.settings.image
          assign media_link = tile_block.settings.link
          assign media_alt = tile_block.settings.alt | default: media_image.alt | default: media_video.alt
          assign is_external = false
          if media_link contains 'http' and media_link contains request.host
          elsif media_link contains 'http'
            assign is_external = true
          endif
        -%}
        {%- if media_video != blank -%}
          <video-media autoplay class="sweet-social__media">{{- media_video | video_tag: playsinline: true, muted: true, loop: true, preload: 'metadata', image_size: '800x' -}}</video-media>
        {%- elsif media_image != blank -%}
          {{- media_image | image_url: width: media_image.width | image_tag: loading: 'lazy', sizes: '(max-width: 699px) 60vw, 320px', widths: '240,320,480,640,800', class: 'sweet-social__media', alt: media_alt -}}
        {%- endif -%}
        <a href="{{ media_link }}" {% if is_external %}target="_blank" rel="noopener"{% endif %} aria-label="{{ media_alt | escape }}" {{ tile_block.shopify_attributes }}></a>
      {%- endif -%}
    {%- endfor -%}
    <a href="{{ instagram_url | default: '#' }}" class="sweet-social__more" {% if instagram_url contains 'http' %}target="_blank" rel="noopener"{% endif %} style="--more-background: {{ section.settings.more_background }}; --more-text: {{ section.settings.more_text_color }};"><span>{{ section.settings.more_text | escape }}</span></a>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Sweet social",
  "class": "shopify-section--sweet-social",
  "tag": "section",
  "max_blocks": 11,
  "settings": [
    { "type": "paragraph", "content": "Lägg till upp till 11 bilder eller klipp. De fyller rutorna i ordning (grupp för grupp, uppifrån och ned). Sista rutan är alltid \"Visa fler bilder\"." },
    { "type": "text", "id": "title", "label": "Rubrik", "default": "Sweet social" },
    { "type": "url", "id": "instagram_url", "label": "Länk för \"Visa fler bilder\"", "info": "Tomt: Instagram-länken under Temainställningar → Sociala medier." },
    { "type": "text", "id": "more_text", "label": "Text i sista rutan", "default": "Visa fler bilder" },
    { "type": "color", "id": "more_background", "label": "Sista rutan: bakgrund", "default": "#00234a" },
    { "type": "color", "id": "more_text_color", "label": "Sista rutan: text", "default": "#ffffff" },
    { "type": "checkbox", "id": "show_all_mobile", "label": "Visa alla rutor på mobil", "default": false, "info": "Av: mobilen visar första och sista gruppen (7 bilder + Visa fler bilder), som apohem.se." }
  ],
  "blocks": [
    {
      "type": "media",
      "name": "Bild eller klipp",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Bild" },
        { "type": "video", "id": "video", "label": "Klipp", "info": "Spelas upp utan ljud och i loop. Används i stället för bilden." },
        { "type": "url", "id": "link", "label": "Länk", "info": "T.ex. inlägget på Instagram eller en produkt." },
        { "type": "text", "id": "alt", "label": "Beskrivning (för skärmläsare)" }
      ]
    }
  ],
  "presets": [{ "name": "Sweet social" }]
}
{% endschema %}
